# Build context for backend/Dockerfile is the repository root; this file (BuildKit, Docker 23+) applies only to that Dockerfile.
# Send only what the image needs. SECRETS (backend/.env) are never sent to the build.
*
!backend/
!data/static/

backend/.env
backend/.env.*
backend/**/__pycache__/
backend/**/*.py[cod]
backend/.pytest_cache/
backend/tests/
backend/.venv/
backend/*.log
