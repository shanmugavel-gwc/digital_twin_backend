# Backend (FastAPI / Python) ignore rules.

# Secrets: the real configuration lives only in backend/.env (CLAUDE.md hard rule). Keep the template.
.env
.env.*
*.env.local
!.env.example

# Python bytecode, packaging and virtual environments
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Test, type-check and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local logs and editor files
*.log
.idea/
.vscode/
*.swp
.DS_Store
