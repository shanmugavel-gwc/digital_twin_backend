NEON_DATABASE_URL=postgresql+psycopg://<app_user>:<pw>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
NEON_DIRECT_URL=postgresql+psycopg://<owner>:<pw>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require
NEON_READONLY_URL=postgresql+psycopg://twin_ro:<pw>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DOMO_SUBDOMAIN=gwcteq-partner
DOMO_TOKEN=
DOMO_MODEL=
APP_ENV=dev
# Passwords used ONLY by scripts/apply_roles.py when creating the twin_rw / twin_ro roles
TWIN_RW_PASSWORD=
TWIN_RO_PASSWORD=
# Required (X-API-Key) for all non-health routes from Phase 5
API_KEY=
# Data-quality switch: "data" keeps dim_machine.plant_id as supplied, "line" overrides it from line->plant mapping
MACHINE_PLANT_SOURCE=data

# Optional read-only external sources (Data connectors page). Leave empty to keep them NOT_CONNECTED. Use accounts with SELECT / read-only rights only.
PG_SOURCE_URL=
MYSQL_SOURCE_URL=
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE=
SHAREPOINT_FOLDER=

# Notifications (email + Microsoft Teams). Leave empty to keep them NOT_CONFIGURED (messages are prepared, never faked as sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
TEAMS_WEBHOOK_URL=

# Enterprise integrations (Integrations page). Secrets can be set here as INTEG_<CONNECTOR>_<FIELD>, e.g. INTEG_SAP_PASSWORD,
# INTEG_REST_API_KEY, INTEG_POWERBI_PUSH_URL; or entered in the UI (held in backend memory only, lost on restart). Never stored in the DB.
